{
  "name": "@abhitsian/myday",
  "version": "0.1.0",
  "description": "A private, local memory of what you did on your Mac \u2014 10-minute Markdown records, searchable, and readable by your AI coding agent over MCP",
  "keywords": [
    "mcp",
    "memory",
    "activity",
    "macos",
    "productivity",
    "claude",
    "agent",
    "privacy",
    "local-first"
  ],
  "bin": {
    "myday": "bin/myday.js",
    "myday-mcp": "mcp/server.js"
  },
  "main": "lib/store.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin"
  ],
  "license": "MIT",
  "files": [
    "bin",
    "lib",
    "mcp",
    "helper",
    "public",
    "README.md",
    "THREAT-MODEL.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node -e \"console.log('\\nmyday installed. Run: myday init\\n')\""
  },
  "publishConfig": {
    "access": "public"
  }
}